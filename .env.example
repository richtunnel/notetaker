# Template for local runs — copy to .env and fill in real values.
# NOTEHIVE_CRYPTO_* are REQUIRED in production (fail-closed otherwise).

# PostgreSQL
QUARKUS_DATASOURCE_USERNAME=notehive_app
QUARKUS_DATASOURCE_PASSWORD=change-me-app
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://localhost:5432/notehive
NOTEHIVE_WORKER_DB_USERNAME=notehive_worker
NOTEHIVE_WORKER_DB_PASSWORD=change-me-worker

# Redis
NOTEHIVE_REDIS_URL=redis://localhost:6379/0

# JWT (either static PEM or JWKS/SSO)
NOTEHIVE_JWT_KEY_MODE=static
NOTEHIVE_JWT_PUBLIC_KEY=
NOTEHIVE_JWT_PRIVATE_KEY=
# NOTEHIVE_JWT_KEY_MODE=jwks
# NOTEHIVE_JWT_JWKS_URL=https://keycloak.example.com/realms/notehive/protocol/openid-connect/certs

# Crypto (32-byte base64 values)
NOTEHIVE_CRYPTO_AES_KEY=
NOTEHIVE_CRYPTO_CURSOR_KEY=

# Cookies
NOTEHIVE_SECURE_COOKIES=true
